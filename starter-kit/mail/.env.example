# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요. (mail 폴더 안에 두면 됩니다)
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.
#    직원(Claude Code)도 이 값을 화면에 찍지 않습니다. 물어보지도 않습니다.
#
# 여기에 없으면 slack-server/.env 에 같은 이름으로 적어도 됩니다 (mail/.env 가 먼저입니다).

# 어느 메일을 쓰나 — naver / daum / gmail 중 하나
MAIL_PROVIDER=naver

# 내 메일 주소 전체 (예: hong@naver.com, hong@hanmail.net, hong@gmail.com)
MAIL_USER=아이디@naver.com

# 앱 비밀번호 — 평소 로그인 비밀번호가 아닙니다. 아래 위치에서 새로 발급받은 값을 붙여넣으세요.
#   네이버: 네이버 메일 → 환경설정 → POP3/IMAP 설정 → IMAP 사용 "사용함" 으로 켜기
#           + 네이버 계정(nid.naver.com) → 보안 → 2단계 인증 켜기 → 애플리케이션 비밀번호 발급
#   다음  : Daum 메일 → 설정 → IMAP/SMTP 사용 켜기 + 카카오계정 → 2단계 인증 켜기 → 앱 비밀번호 발급
#   지메일: 구글 계정(myaccount.google.com) → 보안 → 2단계 인증 켜기 → 앱 비밀번호 발급
#   (띄어쓰기 없이, 따옴표 없이 붙여넣습니다)
MAIL_APP_PASSWORD=

# 외부 발송 잠금 — 0 이면 내 주소(MAIL_USER)로만 보낼 수 있습니다. 남에게 보내려면 1 로 바꾸세요.
#   기본은 0 입니다. 직원이 초안을 만들고, 실제 발송은 내가 확인한 뒤에만 나가게 하는 안전장치입니다.
MAIL_ALLOW_EXTERNAL=0
