# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요.
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.
#
# 값 받아오는 법은 교안 2~3쪽(슬랙 ①·②)을 보세요.
# 보통은 환경점검.bat 이 이 파일을 대신 만들어 줍니다 — 열쇠 3개를 붙여넣으면 BOM 없이 저장됩니다.

# 내 이름 (직원들이 나를 부를 때 쓰는 이름). 한글로 적으세요.
# 여기를 채우면 직원이 이름을 틀릴 일이 없습니다 — 파일을 읽다 깨지거나
# 슬랙 프로필의 영문 이름을 잘못 옮기는 일이 여기서 막힙니다.
OWNER_NAME=

# 슬랙 봇 토큰 — xoxb- 로 시작합니다
SLACK_BOT_TOKEN=

# 슬랙 앱 토큰 — xapp- 로 시작합니다
SLACK_APP_TOKEN=

# 내 워크스페이스에서 내 멤버 ID (U 로 시작). 비우면 서버가 켜지지 않습니다.
# 슬랙 앱 → 내 프로필 사진 → 프로필 → ⋯ 더보기 → 멤버 ID 복사
OWNER_USER_ID=

# ── 아래는 안 채워도 됩니다 (기본값으로 돕니다) ──
# 슬랙 답에 쓸 모델. 기본 sonnet — 답이 빠릅니다. 제안서·교재 품질을 더 올리고 싶으면 opus.
# AGENT_MODEL=sonnet
# 한 대화에서 이만큼 주고받으면 서버가 스스로 새 대화를 시작합니다 (느려짐·역할 섞임 방지)
# SESSION_MAX_TURNS=60
# 슬랙으로 받을 파일의 최대 크기(MB). 기본 25
# MAX_FILE_MB=25
# 이 초가 지나도 답이 없으면 "아직 만드는 중" 한 줄을 먼저 보냅니다
# INTERIM_SEC=90

# ── 저녁 8시 자동 블로그 (카드 P20-c) 를 쓸 때만 ──
# P20-b 에서 만든 Incoming Webhook 주소. 저녁 점검 결과를 이 주소로 알립니다.
# 비워두면 자동 블로그는 돌기는 하지만 슬랙 알림만 안 갑니다.
SLACK_WEBHOOK_URL=
