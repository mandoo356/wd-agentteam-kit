# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요.
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.
#
# 값 받아오는 법은 교안 2~3쪽(슬랙 ①·②)을 보세요.
# 보통은 환경점검.bat 이 이 파일을 대신 만들어 줍니다 — 열쇠 3개를 붙여넣으면 BOM 없이 저장됩니다.

# 슬랙 봇 토큰 — xoxb- 로 시작합니다
SLACK_BOT_TOKEN=

# 슬랙 앱 토큰 — xapp- 로 시작합니다
SLACK_APP_TOKEN=

# 내 워크스페이스에서 내 멤버 ID (U 로 시작). 비우면 서버가 켜지지 않습니다.
# 슬랙 앱 → 내 프로필 사진 → 프로필 → ⋯ 더보기 → 멤버 ID 복사
OWNER_USER_ID=
